NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — full DB access, bypasses RLS. Never expose to the client
# (no NEXT_PUBLIC_ prefix), never commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Signs dashboard session cookies. If unset, a key derived from
# SUPABASE_SECRET_KEY is used. Set it (32+ random characters) to be able to
# sign everyone out by changing it, without rotating the database key.
# SESSION_SECRET=
