# ─────────────────────────────────────────────────────────────────────────────
# Mila Academy — environment variables
#
# LOCAL:   copy this file to .env.local and fill in the values.
#          .env.local is gitignored — never commit it.
# NETLIFY: add the same keys under Site configuration → Environment variables,
#          then Deploys → Trigger deploy → "Clear cache and deploy site".
#          NEXT_PUBLIC_ values are baked in when the site is built, so a
#          change does nothing until you rebuild.
#
# Leaving a placeholder below unchanged (the x's, "your-project-ref") makes the
# app treat Supabase as "not configured": the site still loads, with default
# text and no programs, testimonials, photos or login.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ─────────────────────────────────────────────────────────────────

# Supabase project URL.
# Supabase dashboard → your project → "Connect" (top bar). Looks like
# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — safe to expose; it ships to every visitor's browser.
# Supabase dashboard → Settings → API Keys → "Publishable key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server-only. It bypasses every Row Level Security policy, i.e.
# full read/write access to the whole database.
#   • Never give it a NEXT_PUBLIC_ prefix (that would ship it to browsers).
#   • Never commit it, paste it into chat or email, or put it in a URL.
#   • On Netlify, tick "Contains secret values" when adding it.
# Supabase dashboard → Settings → API Keys → "Secret keys". Create one if none
# is listed. Supabase recommends a separate secret key per deployment (one for
# local, one for Netlify) so a leak only means rotating that one.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# The site's public address. Used to build absolute link-preview image URLs
# (what WhatsApp, Facebook etc. show when the site is shared).
#   Local:   http://localhost:3000
#   Netlify: https://your-site.netlify.app   (or your custom domain)
# A missing "https://" is tolerated, and an empty or invalid value falls back to
# localhost rather than breaking the site — but previews will be wrong.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Optional ─────────────────────────────────────────────────────────────────

# Signs dashboard login sessions. If unset, a key derived from
# SUPABASE_SECRET_KEY is used, so login works without it. Set it (32+ random
# characters) to be able to sign everyone out at once by changing it, without
# rotating the database key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=
